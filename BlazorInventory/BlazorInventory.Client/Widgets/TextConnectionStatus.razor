@inherits StatefulComponentBase<CircuitConnectionInfo>

@{
    var kind = State.Value.Kind;
    var text = kind switch {
        CircuitConnectionKind.Connected => "Connected",
        CircuitConnectionKind.Disconnected => "Disconnected (reconnecting…)",
        _ => "Unknown",
    };
}

<div style="@($"margin: 0 1px; color: {(kind == CircuitConnectionKind.Disconnected ? "yellow" : "black")}")">
    <span>Connection state: </span>
    <strong>@text</strong>
</div>

@code {
    [Inject] private ICircuitConnectionState CircuitState { get; init; } = null!;

    protected override void OnInitialized()
        => SetState(CircuitState.State);

    public override ValueTask DisposeAsync()
        => default; // State is owned by the scoped service
}
