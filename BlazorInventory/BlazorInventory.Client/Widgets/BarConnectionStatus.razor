@inherits StatefulComponentBase<CircuitConnectionInfo>

@{
    var kind = State.Value.Kind;
    var icon = kind switch {
        CircuitConnectionKind.Connected => "cloud",
        CircuitConnectionKind.Disconnected => "warning",
        _ => "minus-circle",
    };
    var color = kind switch {
        CircuitConnectionKind.Connected => "#52c41a",
        CircuitConnectionKind.Disconnected => "#faad14",
        _ => "#999",
    };
    var text = kind switch {
        CircuitConnectionKind.Connected => "Connected",
        CircuitConnectionKind.Disconnected => "Connection lost – reconnecting…",
        _ => "–",
    };
}

<div class="@CssClass">
    <Icon Type="@icon" Style="@($"color: {color};")" />
    <span Style="@($"color: {color};")" Title="@text">@text</span>
</div>

@code {
    [Inject] private ICircuitConnectionState CircuitState { get; init; } = null!;

    [Parameter] public string CssClass { get; set; } = "";

    protected override void OnInitialized()
        => SetState(CircuitState.State);

    public override ValueTask DisposeAsync()
        => default; // State is owned by the scoped service
}
