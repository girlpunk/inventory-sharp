<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>

        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

        <PreserveCompilationContext>true</PreserveCompilationContext>

        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnablePackageValidation>true</EnablePackageValidation>
        <EnableStrictModeForBaselineValidation>true</EnableStrictModeForBaselineValidation>
        <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>

        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <RepositoryUrl>https://github.com/girlpunk/inventory-sharp.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <!-- <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <IsTrimmable>true</IsTrimmable>
        <WasmEnableWebcil>true</WasmEnableWebcil>
        <WasmEnableSIMD>true</WasmEnableSIMD> -->

        <MvcBuildViews Condition="'$(Configuration)'=='Debug'">false</MvcBuildViews>
        <MvcBuildViews Condition="'$(Configuration)'=='Release'">true</MvcBuildViews>

        <MvcRazorCompileOnPublish>true</MvcRazorCompileOnPublish>
    </PropertyGroup>

    <!-- Extra trimming roots -->
    <ItemGroup>
        <TrimmerRootAssembly Include="BlazorInventory.Client" />
        <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\BlazorInventory.Abstractions\BlazorInventory.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AntDesign" Version="1.6.0" />
        <PackageReference Include="ActualLab.Fusion" Version="14.3.34" />
        <PackageReference Include="AsyncFixer" Version="2.1.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Humanizer.Core" Version="3.0.10" />
        <PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Lindhart.Analyser.MissingAwaitWarning" Version="3.2.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.191">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Meziantou.Analyzer.Annotations" Version="1.7.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.5" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
        <PackageReference Include="ActualLab.Fusion.Blazor" Version="14.3.34" />
        <PackageReference Include="ActualLab.Fusion.Blazor.Authentication" Version="14.3.34" />
        <PackageReference Include="ActualLab.Fusion.Ext.Contracts" Version="14.3.34" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.CodeFixes" Version="5.0.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="UAParser" Version="3.1.47" />
        <PackageReference Include="ZXingBlazor" Version="1.1.6" />
    </ItemGroup>

    <!-- Roslyn generators/analyzers -->
    <ItemGroup>
        <PackageReference Include="ActualLab.Generators" PrivateAssets="all" Version="14.3.34" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Layout\MainLayout.razor" />
      <AdditionalFiles Include="Pages\Item\Create.razor" />
      <AdditionalFiles Include="Pages\Item\Details.razor" />
      <AdditionalFiles Include="Pages\Item\Index.razor" />
      <AdditionalFiles Include="Pages\Label\Details.razor" />
      <AdditionalFiles Include="Pages\Scan\Details.razor" />
      <AdditionalFiles Include="Widgets\ImagesWidget.razor" />
      <AdditionalFiles Include="Widgets\ItemWidget.razor" />
      <AdditionalFiles Include="Widgets\LabelsWidget.razor" />
      <AdditionalFiles Include="Widgets\MapBox.razor" />
      <AdditionalFiles Include="Widgets\ScansWidget.razor" />
      <AdditionalFiles Include="Widgets\TagsWidget.razor" />
    </ItemGroup>

    <Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
        <Exec
          Command="git describe --long --always --dirty --exclude=* --abbrev=8"
          ConsoleToMSBuild="True"
          IgnoreExitCode="False"
        >
          <Output PropertyName="SourceRevisionId" TaskParameter="ConsoleOutput"/>
        </Exec>
    </Target>
</Project>
